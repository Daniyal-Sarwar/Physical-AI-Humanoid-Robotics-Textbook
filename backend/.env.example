# ============================================
# Physical AI Textbook Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Vercel: Add these in Dashboard → Settings → Environment Variables

# ============================================
# 🔴 REQUIRED - Must change for production!
# ============================================

# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Session Secret - Generate with: openssl rand -hex 32
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Google Gemini API Key - Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Environment - Set to "production" for deployment
ENVIRONMENT=production

# ============================================
# 🟡 RECOMMENDED - Configure for your setup
# ============================================

# Frontend URL for CORS (your Vercel frontend URL)
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# 🟢 OPTIONAL - Defaults are usually fine
# ============================================

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_EXPIRATION_SECONDS=604800

# Rate Limiting
ANONYMOUS_RATE_LIMIT=5
RATE_LIMIT_WINDOW_HOURS=24

# Database (SQLite path)
SQLITE_DB_PATH=sqlite:///./data/users.db

# ChromaDB (Vector store for RAG)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=physical_ai_textbook

# Server Settings
DEBUG=False
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
